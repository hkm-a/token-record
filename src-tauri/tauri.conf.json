{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Token记录",
  "version": "1.5.8",
  "identifier": "com.hkma.token-record",
  "build": {
    "frontendDist": "../src/renderer",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Token记录",
        "label": "main",
        "width": 420,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true,
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Token记录"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "wix": null,
      "nsis": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBQUE2NDVDQTAxRjRGODQKUldTRVR4K2dYR1NxaWcwMEdtakk2RXNNYUtBWXhrYkFCMXpNeGRxYVI2QWd2N0d2bUdicnI0TTIK",
      "endpoints": [
        "https://api.github.com/repos/hkm-a/token-record/releases/latest"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
